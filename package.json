{
  "name": "teaching-interactive-web-workflow",
  "version": "1.0.0",
  "private": true,
  "description": "教学互动网页开发工作流 · 单课源码单一真源 + Vite 构建发布",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "predev": "npm run build:editor",
    "build": "npm run typecheck && npm run build:editor && node scripts/build.mjs",
    "build:editor": "vite build --config vite.editor.config.ts",
    "build:all": "npm run build:editor && node scripts/build.mjs",
    "build:lesson": "npm run build:editor && node scripts/build.mjs --lesson",
    "assemble": "node scripts/assemble.mjs",
    "deploy": "node scripts/deploy.mjs",
    "check": "node scripts/check.mjs",
    "migrate:practice": "node scripts/migrate-practice.mjs",
    "fonts": "node scripts/subset-fonts.mjs",
    "typecheck": "tsc --noEmit",
    "typecheck:lesson": "node scripts/typecheck.mjs --lesson",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "d3-hierarchy": "^3.1.2",
    "echarts": "^6.1.0",
    "gsap": "^3.15.0",
    "suneditor": "^3.3.3",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@types/d3-hierarchy": "^3.1.7",
    "@types/node": "^26.1.2",
    "@types/three": "^0.180.0",
    "archiver": "^8.0.0",
    "gifsicle": "^7.0.1",
    "jsdom": "^26.0.0",
    "sharp": "^0.35.3",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^3.0.0"
  }
}
