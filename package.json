{
  "name": "teaching-interactive-web-workflow",
  "version": "1.0.0",
  "private": true,
  "description": "教学互动网页开发工作流 · 单课源码单一真源 + Vite 构建发布",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "build:all": "node scripts/build.mjs",
    "build:lesson": "node scripts/build.mjs --lesson",
    "assemble": "node scripts/assemble.mjs",
    "deploy": "node scripts/deploy.mjs",
    "check": "node scripts/check.mjs",
    "typecheck": "tsc --noEmit",
    "typecheck:lesson": "node scripts/typecheck.mjs --lesson",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/three": "^0.180.0",
    "archiver": "^8.0.0",
    "jsdom": "^26.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^3.0.0"
  }
}
